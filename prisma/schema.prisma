// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" 
}

// =================
// Modelos chotos
// =================

model hotel {
  id        Int      @id @default(autoincrement())
  nombre      String
  localizacion  String
  cantidad_habitaciones     Int
  imagen_h String? 
  descripcion String
  precio  Int
  tiene_catering Boolean
  fecha_subido DateTime @default(now())
  fecha_actualizado DateTime @updatedAt
} 
model Formulario {
  id        Int      @id @default(autoincrement())
  nombre_completo     String
  gmail  String
  cantidad_huespedes   Int
  llegada DateTime @db.Date
  salida DateTime @db.Date
  fecha_subido DateTime @default(now())
  fecha_actualizado DateTime @updatedAt
} 

model Usuario {
  id                  Int        @id @default(autoincrement())
  gmail               String
  password            String
  estatus             String
  fecha_subido        DateTime   @default(now())
  fecha_actualizado   DateTime   @updatedAt
  favoritos           Favorito[]
  busquedas           Busqueda[]

  // Contador "cacheado": guarda el total de busquedas ya calculado.
  // Evita tener que contar fila por fila cada vez que se abre la pagina.
  busquedasTotal      Int        @default(0)
}

model Favorito {
  id                Int      @id @default(autoincrement())
  idUsuario         Int
  usuario           Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  nombreAlojamiento String
  precio            Float?
  urlOrigen         String
  imagenUrl         String?
  fechaGuardado     DateTime @default(now())

  @@unique([idUsuario, urlOrigen])
}

// Historial: una fila por cada busqueda que hace un usuario logueado.
// Es la fuente de verdad del contador (se puede recalcular desde aca).
model Busqueda {
  id         Int      @id @default(autoincrement())
  idUsuario  Int
  usuario    Usuario  @relation(fields: [idUsuario], references: [id], onDelete: Cascade)
  destino    String
  huespedes  Int
  fecha      DateTime @default(now())

  // Indice clave: hace que contar/listar las busquedas de UN usuario
  // sea instantaneo, sin recorrer toda la tabla.
  @@index([idUsuario, fecha(sort: Desc)])
}
