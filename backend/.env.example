# Copiá este archivo como ".env" (en esta misma carpeta) y completá los valores.
# El archivo .env NUNCA se sube a git.
PORT=3000

# Tavily: https://app.tavily.com (1.000 créditos gratis por mes)
TAVILY_API_KEY=

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Google da de baja modelos seguido (gemini-2.5-flash ya se apagó en octubre de 2026).
# Si las búsquedas fallan con error 404, cambiá SOLO esta línea y reiniciá.
# Lista vigente: https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_MODEL=gemini-3.5-flash

# Moneda en la que se interpreta el "precio máximo" del filtro
MONEDA_FILTRO=USD

# Base de datos de usuarios y favoritos (SQLite, se crea en backend/prisma/dev.db)
DATABASE_URL="file:./dev.db"

# Secreto para firmar las sesiones. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
